#!/usr/bin/env bash
# agent-runner 的開關。薄殼：底下是 systemctl --user，邏輯都在 src/。
# install.sh（#2703）把它連到 ~/.local/bin。
set -euo pipefail

RUNNER_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
UNIT_DIR="$HOME/.config/systemd/user"
STATE_DIR="$HOME/.local/state/agent-runner"
TIMER=agent-runner.timer
AUTOOFF_TIMER=agent-runner-autooff.timer
SERVICE=agent-runner.service

usage() {
  cat <<USAGE
usage: agent-runner <command>

  on           打開：立刻跑一輪，之後每隔一段時間一輪，到點自動關（間隔與時間見 src/config.ts）
  off          關掉：正在做的那張做完，不再接新單
  off --now    立刻停：中斷正在做的那張、照 crash 收尾（最多等 5 分鐘）
  status       開關、下次觸發、目前在跑哪張、runner commit

  update                  更新 runner：git pull --ff-only + npm ci（runner 只透過這個更新）
  rebuild                 同一個 tag 不用 cache 重 build sandbox image（更新 Claude CLI）
  clean-store             清空 runner 自己的 pnpm store
  clean-worktrees [--all] 刪 bot clone 裡超過 3 天的 sandcastle worktree；--all 全刪

  維護指令要跟一輪搶同一把鎖：有一輪在跑就不動手。
USAGE
}

user_ctl() { systemctl --user "$@"; }

# 下次觸發時間；timer 沒在跑就是 -
# 從 list-timers 拿：agent-runner.timer 用 OnUnitActiveSec（單調時鐘），NextElapseUSecRealtime 永遠是空的
next_elapse() {
  local next
  next="$(user_ctl list-timers --all --no-legend --no-pager "$1" 2>/dev/null | awk '$1 != "-" && $1 != "n/a" { print $1, $2, $3, $4 }')"
  echo "${next:--}"
}

# 一輪正在跑嗎。service 是 Type=oneshot：跑的整段時間是 activating，`is-active` 只認 active
round_running() {
  local state
  state="$(user_ctl show -p ActiveState --value "$SERVICE")"
  [ "$state" = activating ] || [ "$state" = active ]
}

# timer 的間隔與自動關時間從 src/config.ts 寫成 drop-in（src/systemd.ts），改了設定下次 on 就生效
write_timer_dropins() {
  (load_node && node --import tsx src/cli.ts write-timer-dropins "$UNIT_DIR")
  user_ctl daemon-reload
}

cmd_on() {
  write_timer_dropins
  user_ctl start "$AUTOOFF_TIMER" "$TIMER"
  # 打開就先跑一輪；timer 從這一輪開始算 OnUnitActiveSec。不用 timer 的 OnActiveSec=0 ——
  # 那個每次 daemon-reload（update、改設定）都會再觸發一輪
  round_running || user_ctl start --no-block "$SERVICE"
  echo "on：下一輪 $(next_elapse "$TIMER")，自動關 $(next_elapse "$AUTOOFF_TIMER")"
}

cmd_off() {
  case "${1:-}" in
    "")
      user_ctl stop "$TIMER"
      if round_running; then
        echo "off：正在做的那張做完就停"
      else
        echo "off"
      fi
      ;;
    --now)
      user_ctl stop "$TIMER"
      # 等 runner 收完尾才回來（agent-runner.service 的 KillSignal／TimeoutStopSec）
      user_ctl stop "$SERVICE"
      rm -f "$STATE_DIR/current"
      echo "off：已立刻停下，正在做的那張照 crash 收尾"
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

cmd_status() {
  local switch=off current=-
  user_ctl is-active --quiet "$TIMER" && switch=on
  # service 沒在跑時 current 可能是被砍掉那輪留下的，不算數
  if round_running; then
    current="$(cat "$STATE_DIR/current" 2>/dev/null || echo "（挑單中）")"
  fi
  echo "開關：      $switch"
  echo "下一輪：    $(next_elapse "$TIMER")"
  echo "自動關：    $(next_elapse "$AUTOOFF_TIMER")"
  echo "目前在跑：  $current"
  echo "runner：    $(git -C "$RUNNER_DIR" rev-parse --short HEAD)"
}

# user service 沒有互動 shell 的 PATH，node 從 nvm 的 default 拿。
# nvm.sh 不是為 set -eu 寫的（會讀沒設的變數、內部指令會回非 0），source 和 nvm use 期間先關掉
load_node() {
  if ! command -v node >/dev/null; then
    set +eu
    # shellcheck source=/dev/null
    . "${NVM_DIR:-$HOME/.nvm}/nvm.sh"
    nvm use --silent default >/dev/null
    set -eu
  fi
  cd "$RUNNER_DIR"
}

# systemd 叫的那一輪。
# exec node（不經 npm）：node 要是 service 的 main process，off --now 的 KillSignal 才會直接送到它。
cmd_round() {
  load_node
  exec node --import tsx src/main.ts
}

# 維護指令跟一輪拿同一把鎖（src/lock.ts 的 round.lock）：拿不到就不動手，不等。
# fd 9 一路帶到 exec 出去的 node，指令跑完才放掉。
with_round_lock() {
  mkdir -p "$STATE_DIR"
  exec 9>>"$STATE_DIR/round.lock"
  if ! flock -n 9; then
    echo "agent-runner: 有一輪正在跑，等它做完（或 agent-runner off --now）再來" >&2
    exit 1
  fi
}

cmd_update() {
  with_round_lock
  git -C "$RUNNER_DIR" pull --ff-only
  (cd "$RUNNER_DIR" && npm ci)
  # units 是連到 repo 的 symlink，內容變了要 reload 才生效；新增的 unit 要重跑 install.sh。
  # 設定可能改了間隔或自動關時間，drop-in 一起重寫
  write_timer_dropins
  echo "update：runner 在 $(git -C "$RUNNER_DIR" rev-parse --short HEAD)"
}

# rebuild／clean-store／clean-worktrees 要讀設定、碰 docker 或 bot clone，在 src/cli.ts
cmd_maintain() {
  with_round_lock
  load_node
  exec node --import tsx src/cli.ts "$@"
}

# agent-runner-failure.service（OnFailure=）叫的；不拿鎖，失敗那一輪已經結束了
cmd_notify_failure() {
  load_node
  exec node --import tsx src/cli.ts notify-failure
}

case "${1:-}" in
  on) cmd_on ;;
  off) shift; cmd_off "$@" ;;
  status) cmd_status ;;
  update) cmd_update ;;
  rebuild | clean-store) cmd_maintain "$1" ;;
  clean-worktrees)
    case "${2:-}" in
      "" | --all) cmd_maintain "$@" ;;
      *)
        usage >&2
        exit 2
        ;;
    esac
    ;;
  round) cmd_round ;;
  notify-failure) cmd_notify_failure ;;
  -h | --help | help) usage ;;
  *)
    usage >&2
    exit 2
    ;;
esac
